# OPTRANE Lovable backend — SERVER-ONLY configuration.
# Never copy these values into the Tauri/Vite desktop environment.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Cloud / Vertex AI + deployed ADK Agent Runtime.
GEMINI_PROVIDER=vertex
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_AGENT_ENGINE_RESOURCE=projects/PROJECT/locations/REGION/reasoningEngines/RESOURCE_ID

# Optional local fallback only.
GEMINI_API_KEY=

# Deterministic backend writes / fact mirror to ClickHouse Cloud HTTP API.
CLICKHOUSE_HTTP_URL=https://YOUR_CLICKHOUSE_HOST:8443
CLICKHOUSE_USER=optrane_writer
CLICKHOUSE_PASSWORD=

# Official mcp-clickhouse Streamable HTTP service used by Google ADK.
CLICKHOUSE_MCP_URL=https://YOUR_MCP_SERVICE.run.app/mcp
CLICKHOUSE_MCP_TOKEN=

# Strict mode.
OPTRANE_REQUIRE_MCP=true
OPTRANE_REQUIRE_AGENT_RUNTIME=true
OPTRANE_REQUIRE_GOVERNANCE=true
OPTRANE_DEMO_MODE=true

# Public Lovable website origin used for website registration and desktop verification.
OPTRANE_WEB_BASE=https://film-sparkle-layer.lovable.app

# Private/manual governance peer administration endpoint authentication.
OPTRANE_GOVERNANCE_ADMIN_KEY=

# Private OPTRANE <-> governance provider peer connection.
# The desktop never receives any of these values or the provider endpoint path.
AGENTCESS_API_BASE=https://<governance-provider-host>/api
AGENTCESS_CLIENT_ID=
AGENTCESS_CLIENT_SECRET=
AGENTCESS_WORKSPACE_ID=
AGENTCESS_WEBHOOK_SECRET=

# Ed25519 PEM strings. Keep the private key only in Lovable/Supabase secrets.
OPTRANE_AGENTCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OPTRANE_AGENTCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Recording-only demo account allow-list (comma-separated). Demo preparation
# routes reject every other authenticated account even when OPTRANE_DEMO_MODE=true.
OPTRANE_RECORDING_TEST_EMAILS=khrystynaklochko@gmail.com
