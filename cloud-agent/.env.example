GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-agent-staging-bucket

# Official mcp-clickhouse endpoint deployed from ../clickhouse-mcp
OPTRANE_MCP_URL=https://YOUR_MCP_SERVICE.run.app/mcp
OPTRANE_MCP_TOKEN=replace-with-a-long-random-token
OPTRANE_AGENT_MODEL=gemini-3.5-flash

# Filled after deploy.py succeeds:
GOOGLE_AGENT_ENGINE_RESOURCE=projects/PROJECT/locations/REGION/reasoningEngines/RESOURCE_ID
