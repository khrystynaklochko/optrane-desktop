# OPTRANE Command uses the Lovable website as the human verification surface and
# the public Lovable API as its ONLY application gateway.

# production | preview
VITE_OPTRANE_ENV=production

# Optional overrides. Defaults are already embedded for the current Lovable project.
# VITE_OPTRANE_WEB_BASE=https://film-sparkle-layer.lovable.app
# VITE_OPTRANE_API_PREFIX=/api/public/itrain-api
# VITE_OPTRANE_API_BASE=https://film-sparkle-layer.lovable.app/api/public/itrain-api
# VITE_OPTRANE_DESKTOP_VERIFY_URL=https://film-sparkle-layer.lovable.app/desktop/verify
VITE_OPTRANE_DESKTOP_CALLBACK=optrane://auth/callback

# Publishable Supabase key for the Lovable gateway bootstrap routes (/desktop-auth/*).
# This is public website configuration, not a service-role secret.
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# website = recommended production mode. Direct email/password in Tauri is disabled.
VITE_OPTRANE_AUTH_MODE=website
VITE_OPTRANE_ALLOW_ANONYMOUS_DEMO=false
VITE_OPTRANE_AUTO_DEMO=false
VITE_OPTRANE_DEMO_MODE=true
