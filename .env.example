# OPTRANE Command — desktop environment
# Copy to .env.local for local overrides.

# production | preview
VITE_OPTRANE_ENV=production

# Gateway bases (defaults are embedded; override only when needed)
# Production:
# VITE_OPTRANE_WEB_BASE=https://film-sparkle-layer.lovable.app
# VITE_OPTRANE_API_BASE=https://film-sparkle-layer.lovable.app/api/public/itrain-api
# Preview dev:
# VITE_OPTRANE_WEB_BASE=https://project--309e6175-07ff-41df-81c3-16d713bb13e2-dev.lovable.app
# VITE_OPTRANE_API_BASE=https://project--309e6175-07ff-41df-81c3-16d713bb13e2-dev.lovable.app/api/public/itrain-api

VITE_OPTRANE_API_PREFIX=/api/public/itrain-api
VITE_OPTRANE_DESKTOP_CALLBACK=optrane://auth/callback
VITE_OPTRANE_DESKTOP_VERIFY_URL=https://film-sparkle-layer.lovable.app/desktop/verify

# Publishable Supabase key (public website configuration)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_URL=https://jlcbbwakkvfhfbeheldv.supabase.co

VITE_OPTRANE_AUTH_MODE=website
VITE_OPTRANE_ALLOW_ANONYMOUS_DEMO=false
VITE_OPTRANE_AUTO_DEMO=false
VITE_OPTRANE_DEMO_MODE=true
