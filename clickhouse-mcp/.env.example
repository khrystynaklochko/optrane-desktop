CLICKHOUSE_HOST=YOUR_SERVICE.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=optrane_mcp_reader
CLICKHOUSE_PASSWORD=replace-me
CLICKHOUSE_DATABASE=optrane
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=false

CLICKHOUSE_MCP_SERVER_TRANSPORT=http
CLICKHOUSE_MCP_BIND_HOST=0.0.0.0
CLICKHOUSE_MCP_BIND_PORT=8080
CLICKHOUSE_MCP_AUTH_TOKEN=replace-with-long-random-token
# Include the final Cloud Run Host header after deployment if required by your version:
# CLICKHOUSE_MCP_ALLOWED_HOSTS=your-service-xxxxx.run.app
